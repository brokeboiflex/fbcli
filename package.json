{
  "name": "fbcli",
  "version": "0.1.0",
  "description": "Cookie-only Facebook command-line client for your own account",
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./web-actions": "./src/web-actions.ts"
  },
  "bin": {
    "fbcli": "./fbcli.ts"
  },
  "files": [
    "src",
    "fbcli.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "fbcli": "bun run fbcli.ts",
    "postinstall": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:browser",
    "test:unit": "bun test test/cookies.test.ts test/helpers.test.ts test/cli.test.ts",
    "test:browser": "for f in test/read-actions.test.ts test/write-actions.test.ts test/find-students.test.ts; do bun test \"$f\" || exit 1; done"
  },
  "dependencies": {
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
